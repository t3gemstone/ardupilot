# -------------------------------
# ArduPilot Configuration Options
# -------------------------------

# https://ardupilot.org/dev/docs/ardupilot-on-linux-starting.html

### Configure serial ports
# https://ardupilot.org/copter/docs/common-serial-options.html

# USB Gadget Ethernet, MAVLink2
SERIAL0=--serial0 udp:192.168.7.255:14550:bcast

# Telemetry UART 57600 Baud, MAVLink 1
SERIAL1=--serial1 /dev/ttyS0

#SERIAL2=--serial2

# GPS UART 230400 Baud
SERIAL3=--serial3 /dev/ttyS6

#SERIAL4=--serial4

# SBUS RC input UART 100000 Baud
SERIAL5=--serial5 /dev/ttyS3

#SERIAL6=--serial6
#SERIAL7=--serial7
#SERIAL8=--serial8
#SERIAL9=--serial9

### Change log directory (Optional)
#LOG_DIRECTORY=--log-directory /opt/ardupilot/var/log

### Change terrain directory (Optional)
#TERRAIN_DIRECTORY=--terrain-directory /opt/ardupilot/var/terrain

### Change storage directory (Optional)
#STORAGE_DIRECTORY=--storage-directory /opt/ardupilot/var/storage

### Change module directory (Optional)
#MODULE_DIRECTORY=--module-directory /usr/lib/ardupilot/modules

### Configure CPU affinity (Optional)
#CPU_AFFINITY=--cpu-affinity 2,3
